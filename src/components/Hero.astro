---
import { site } from '../config/site';

const metaChips = site.footerNote.split('·').map((s) => s.trim());
---

<header class="hero">
  <div class="hero-inner container">
    <div class="hero-mark-wrap" aria-hidden="true">
      <span class="hero-orbit hero-orbit-outer"></span>
      <span class="hero-orbit hero-orbit-inner"></span>
      <img class="hero-mark" src="/logo-mark.png" alt="" width="104" height="104" />
    </div>

    <h1 class="hero-wordmark">OpenJarvis</h1>

    <p class="hero-tagline">{site.tagline}</p>

    <p class="hero-desc">{site.subhead}</p>

    <div class="hero-ctas">
      <a href="#quickstart" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13 2 4.5 13.5H11l-1 8.5 9.5-13H13l1-7z"></path>
        </svg>
        Get Started
      </a>
      <a href={site.links.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12 24 5.373 18.627 0 12 0z"></path>
        </svg>
        View on GitHub
      </a>
    </div>

    <p class="hero-meta">
      {metaChips.map((chip) => (
        <span class="hero-meta-chip">{chip}</span>
      ))}
    </p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 96px 0 72px;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-mark-wrap {
    position: relative;
    display: inline-flex;
    margin-bottom: 1.6rem;
    animation: hero-float 6s ease-in-out infinite;
  }

  .hero-mark {
    width: 104px;
    height: 104px;
    filter: drop-shadow(0 0 34px var(--logo-glow));
  }

  /* Orbital rings — a slow satellite dot on the outer, a faint dashed inner */
  .hero-orbit {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-orbit-outer {
    inset: -30px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    animation: orbit-spin 16s linear infinite;
  }
  .hero-orbit-outer::before {
    content: '';
    position: absolute;
    top: -3.5px;
    left: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }
  .hero-orbit-inner {
    inset: -16px;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 14%, transparent);
    animation: orbit-spin 40s linear infinite reverse;
  }

  @keyframes orbit-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    background: linear-gradient(120deg, var(--grad-start) 0%, var(--grad-end) 60%, var(--color-amber) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .hero-tagline {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1.5rem;
  }

  .hero-desc {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.65;
    margin: 0 0 2.25rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2.25rem;
  }
  .hero-ctas .btn { padding: 0.72em 1.45em; font-size: 1rem; }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
  }
  .hero-meta-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.32em 0.85em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }
</style>
