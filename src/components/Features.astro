---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import FeatureCard from './FeatureCard.astro';

const items = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);

// Map each primitive (by order) to its icon glyph in FeatureCard.
const iconByOrder: Record<number, string> = {
  1: 'intelligence',
  2: 'engine',
  3: 'agents',
  4: 'tools',
  5: 'learning',
};
---

<Section id="features" title="Five primitives for personal AI" index={2}>
  <div class="grid">
    {items.map((f, i) => (
      <FeatureCard
        title={f.data.title}
        summary={f.data.summary}
        icon={iconByOrder[f.data.order] ?? 'intelligence'}
        size={i < 2 ? 'lg' : 'md'}
      />
    ))}
  </div>
</Section>

<style>
  /* Bento: two wide cards on the first row, three narrower ones on the second.
     Column spans live on the cards themselves (see FeatureCard.astro). */
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1000px) and (min-width: 761px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
