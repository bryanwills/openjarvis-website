---
interface Props {
  title: string;
  summary: string;
  icon?: string;
}

const { title, summary, icon = 'intelligence' } = Astro.props;

const icons: Record<string, string> = {
  intelligence:
    '<path d="M12 4l1.5 3.8L17.5 9l-4 1.2L12 14l-1.5-3.8L6.5 9l4-1.2L12 4z"/><path d="M18 13.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z"/>',
  engine:
    '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  agents:
    '<circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="M8.4 13.4l7.2 4.2M15.6 6.4l-7.2 4.2"/>',
  tools:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.5-3.5a6 6 0 0 1-7.9 7.9l-6.3 6.3a2.1 2.1 0 0 1-3-3l6.3-6.3a6 6 0 0 1 7.9-7.9l-3.5 3.5z"/>',
  learning:
    '<path d="M3 17l6-6 4 4 7-7"/><path d="M17 7h4v4"/>',
};

const glyph = icons[icon] ?? icons.intelligence;
---

<article class="feature-card">
  <span class="feature-icon" aria-hidden="true">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={glyph}></svg>
  </span>
  <h3 class="feature-title">{title}</h3>
  <p class="feature-desc">{summary}</p>
</article>

<style>
  .feature-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    overflow: hidden;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent 70%);
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-accent);
    box-shadow: 0 14px 36px color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .feature-card:hover::before { opacity: 1; }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    margin-bottom: 1rem;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, transparent);
    box-shadow: 0 0 22px var(--glow-soft);
    transition: transform 0.16s ease;
  }
  .feature-card:hover .feature-icon {
    transform: scale(1.06);
  }

  .feature-title {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }
  .feature-desc {
    font-size: 0.93rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.6;
  }
</style>
