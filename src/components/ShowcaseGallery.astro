---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const items = (await getCollection('showcase')).sort((a, b) => a.data.order - b.data.order);
---

<Section id="showcase" title="See it in action" kicker="Showcase">
  <div class="gallery">
    {items.map((item) => (
      <figure class="gallery-item">
        <div class="img-wrap">
          <img
            src={item.data.image}
            alt={item.data.title}
            loading="lazy"
            width="640"
            height="400"
          />
        </div>
        <figcaption>
          <strong class="caption-title">{item.data.title}</strong>
          <span class="caption-summary">{item.data.summary}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</Section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .gallery-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .img-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg-alt);
  }

  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover .img-wrap img {
    transform: scale(1.03);
  }

  figcaption {
    padding: 0.75rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .caption-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .caption-summary {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
