---
interface Props {
  id: string;
  title: string;
  link?: string;
  linkText?: string;
  external?: boolean;
}

const { id, title, link, linkText, external } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="section-chevron" aria-hidden="true">&#10217;</span>
        {title}
      </h2>
      {link && (
        <a
          class="section-link"
          href={link}
          {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >
          {linkText ?? 'View all'} <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </div>
    <slot />
  </div>
</section>
