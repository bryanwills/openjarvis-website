---
interface Props {
  id: string;
  title: string;
  kicker?: string;
}

const { id, title, kicker } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2>{title}</h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding: 80px 0;
  }

  .kicker {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.5rem;
  }

  h2 {
    margin-bottom: 2.5rem;
  }
</style>
