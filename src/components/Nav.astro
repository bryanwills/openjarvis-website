---
import { site } from '../config/site';
---

<header class="site-topbar">
  <div class="container topbar-inner">
    <a href="/" class="brand" aria-label="OpenJarvis home">
      <img class="brand-mark" src="/logo-mark.png" alt="" width="28" height="28" aria-hidden="true" />
      <span class="brand-name">OpenJarvis</span>
    </a>

    <nav class="topbar-nav" aria-label="Main navigation">
      <a href="#features" class="topbar-link">Features</a>
      <a href="#showcase" class="topbar-link">Showcase</a>
      <a href="#research" class="topbar-link">Research</a>
      <a href="#community" class="topbar-link">Community</a>
      <a href={site.links.docs} class="topbar-link" target="_blank" rel="noopener noreferrer">Docs</a>
    </nav>

    <div class="topbar-actions">
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>

      <a href={site.links.github} class="ghbtn" data-repo={site.links.github} target="_blank" rel="noopener noreferrer" aria-label="Star OpenJarvis on GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path>
        </svg>
        <span class="ghbtn-label">Star</span>
        <span class="ghbtn-stars" hidden aria-hidden="true"></span>
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const current = root.dataset.theme === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      root.classList.add('theme-anim');
      root.dataset.theme = next;
      root.style.colorScheme = next;
      setTimeout(() => root.classList.remove('theme-anim'), 350);
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  }

  const ghLink = document.querySelector<HTMLAnchorElement>('.ghbtn');
  const starEl = document.querySelector<HTMLElement>('.ghbtn-stars');
  if (ghLink && starEl) {
    const slug = (ghLink.dataset.repo ?? '')
      .replace(/^https?:\/\/github\.com\//, '')
      .replace(/\/$/, '');
    if (slug.split('/').length === 2) {
      fetch(`https://api.github.com/repos/${slug}`)
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          const n = d && d.stargazers_count;
          if (typeof n === 'number') {
            starEl.textContent = n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);
            starEl.hidden = false;
            starEl.removeAttribute('aria-hidden');
          }
        })
        .catch(() => {});
    }
  }
</script>

<style>
  .site-topbar {
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-mark {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 8px var(--logo-glow));
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }
  .topbar-link {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .topbar-link:hover {
    color: var(--color-text);
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .theme-toggle:hover { color: var(--color-text); border-color: var(--color-border-accent); }
  .theme-toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .ghbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .ghbtn:hover { color: var(--color-text); border-color: var(--color-border-accent); background: var(--color-surface-strong); }
  .ghbtn-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    padding-left: 0.5rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .ghbtn-stars::before { content: '★'; color: var(--color-amber); font-size: 0.9em; }

  @media (max-width: 860px) {
    .topbar-nav { display: none; }
  }
  @media (max-width: 760px) {
    .ghbtn-label { display: none; }
  }
</style>
