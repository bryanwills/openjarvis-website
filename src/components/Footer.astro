---
import { site } from '../config/site';

const links = [
  { label: 'GitHub', href: site.links.github, ext: true },
  { label: 'Docs', href: site.links.docs, ext: true },
  { label: 'Discord', href: site.links.discord, ext: true },
  { label: 'Paper', href: site.links.paper, ext: true },
  { label: 'Releases', href: site.links.releases, ext: true },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="/" class="footer-brand" aria-label="OpenJarvis home">
      <img class="footer-mark" src="/logo-mark.png" alt="" width="26" height="26" aria-hidden="true" />
      <span>OpenJarvis</span>
    </a>

    <nav class="footer-nav" aria-label="Footer">
      {links.map((l, i) => (
        <>
          {i > 0 && <span class="footer-sep" aria-hidden="true">·</span>}
          <a href={l.href} {...l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{l.label}</a>
        </>
      ))}
    </nav>

    <p class="footer-copy">&copy; {new Date().getFullYear()} OpenJarvis Contributors · Apache-2.0</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding: 3rem 0 2.5rem;
    background: color-mix(in srgb, var(--color-bg-alt) 70%, transparent);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .footer-mark { width: 26px; height: 26px; filter: drop-shadow(0 0 8px var(--logo-glow)); }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.92rem;
  }
  .footer-nav a { color: var(--color-text-secondary); font-weight: 500; }
  .footer-nav a:hover { color: var(--color-accent); }
  .footer-sep { color: var(--color-border); }

  .footer-copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }
</style>
