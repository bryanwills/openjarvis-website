---
import { site } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="OpenJarvis home">
        <img src="/logo-horizontal.png" alt="OpenJarvis" height="28" />
      </a>
      <p class="footer-note">{site.footerNote}</p>
    </div>

    <div class="footer-links">
      <div class="link-group">
        <h3 class="link-group-heading">Project</h3>
        <ul>
          <li><a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={site.links.docs} target="_blank" rel="noopener noreferrer">Docs</a></li>
          <li><a href={site.links.releases} target="_blank" rel="noopener noreferrer">Releases</a></li>
        </ul>
      </div>

      <div class="link-group">
        <h3 class="link-group-heading">Community</h3>
        <ul>
          <li><a href={site.links.discord} target="_blank" rel="noopener noreferrer">Discord</a></li>
          <li><a href={site.links.paper} target="_blank" rel="noopener noreferrer">Paper</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p class="footer-copy">
        &copy; {new Date().getFullYear()} OpenJarvis Contributors. Apache-2.0 license.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-alt);
    margin-top: 5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }

  /* Brand column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 300px;
  }

  .footer-logo {
    display: inline-flex;
    text-decoration: none;
  }

  .footer-logo img {
    height: 28px;
    width: auto;
  }

  .footer-note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    line-height: 1.5;
  }

  /* Link columns */
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }

  .link-group {
    min-width: 120px;
  }

  .link-group-heading {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .link-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link-group ul li {
    margin: 0;
    padding: 0;
    color: inherit;
  }

  .link-group a {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .link-group a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1rem 0;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
    }

    .footer-brand {
      max-width: 100%;
    }
  }
</style>
