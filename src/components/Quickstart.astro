---
import Section from './Section.astro';
import { site } from '../config/site';
---

<Section id="quickstart" title="Get started in one command" kicker="Install">
  <div class="qs-body">
    <div class="code-pill-wrap">
      <code class="code-pill" id="install-cmd">{site.install}</code>
      <button
        id="copy-install-btn-qs"
        class="btn btn-outline copy-btn"
        data-install={site.install}
        aria-label="Copy install command"
      >
        Copy
      </button>
    </div>
    <a
      href={site.links.docs}
      class="btn btn-primary docs-link"
      target="_blank"
      rel="noopener"
    >
      Read the full docs →
    </a>
  </div>
</Section>

<script>
  import { copyText } from '../lib/clipboard';

  const btn = document.querySelector<HTMLButtonElement>('#copy-install-btn-qs');
  if (btn) {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.install ?? '';
      await copyText(text);
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 1500);
    });
  }
</script>

<style>
  .qs-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .code-pill-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.75rem 1rem;
    flex-wrap: wrap;
  }

  .code-pill {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-accent);
    background: none;
    border: none;
    padding: 0;
    white-space: nowrap;
  }

  .copy-btn {
    flex-shrink: 0;
    font-size: 0.85rem;
    padding: 0.35em 0.85em;
  }

  .docs-link {
    font-size: 0.95rem;
  }
</style>
