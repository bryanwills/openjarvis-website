---
import Section from './Section.astro';
import { site } from '../config/site';
---

<Section id="quickstart" title="Quick Start" index={1}>
  <div class="qs-layout">
    <div class="qs-console">
      <div class="code-block">
        <div class="code-header">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
          <div class="mode-switch" role="tablist" aria-label="Quickstart steps">
            <button class="mode-btn active" data-mode="install" role="tab" aria-selected="true">Install</button>
            <button class="mode-btn" data-mode="ask" role="tab" aria-selected="false">Ask</button>
            <button class="mode-btn" data-mode="serve" role="tab" aria-selected="false">Serve</button>
          </div>
        </div>

        <div class="code-body">
          <!-- Install -->
          <div class="code-content" data-content="install">
            <div class="code-line comment"># One command — installs everything for your hardware</div>
            <div class="code-line cmd">
              <span class="prompt">$</span>
              <span class="ctext">{site.install}</span>
              <button class="copy-line" data-copy={site.install} aria-label="Copy command">
                <svg class="ic-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <svg class="ic-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <div class="code-line" aria-hidden="true"><span class="prompt">$</span> <span class="caret"></span></div>
          </div>

          <!-- Ask -->
          <div class="code-content" data-content="ask" hidden>
            <div class="code-line comment"># One-time setup &amp; local model pull</div>
            <div class="code-line cmd">
              <span class="prompt">$</span>
              <span class="ctext">jarvis init</span>
              <button class="copy-line" data-copy="jarvis init" aria-label="Copy command">
                <svg class="ic-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <svg class="ic-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <div class="code-line cmd">
              <span class="prompt">$</span>
              <span class="ctext">jarvis ask <span class="arg">"what's on my calendar today?"</span></span>
              <button class="copy-line" data-copy={'jarvis ask "what\'s on my calendar today?"'} aria-label="Copy command">
                <svg class="ic-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <svg class="ic-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <div class="code-line out">&rarr; answered locally on your GPU · 0 cloud calls · 1.2s</div>
            <div class="code-line" aria-hidden="true"><span class="prompt">$</span> <span class="caret"></span></div>
          </div>

          <!-- Serve -->
          <div class="code-content" data-content="serve" hidden>
            <div class="code-line comment"># Expose an OpenAI-compatible API</div>
            <div class="code-line cmd">
              <span class="prompt">$</span>
              <span class="ctext">jarvis serve</span>
              <button class="copy-line" data-copy="jarvis serve" aria-label="Copy command">
                <svg class="ic-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <svg class="ic-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span class="copy-label">Copy</span>
              </button>
            </div>
            <div class="code-line out">&rarr; live at http://localhost:8000</div>
            <div class="code-line" aria-hidden="true"><span class="prompt">$</span> <span class="caret"></span></div>
          </div>
        </div>
      </div>
    </div>

    <p class="qs-note">
      Runs entirely on your hardware — cloud APIs are optional. Browse and pull local models any time
      with <code>jarvis model</code>.
      <a href={site.links.docs} target="_blank" rel="noopener noreferrer">Read the full docs &rarr;</a>
    </p>
  </div>
</Section>

<script>
  import { copyText } from '../lib/clipboard';

  const root = document.getElementById('quickstart');
  if (root) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.mode-btn');
    const panels = root.querySelectorAll<HTMLElement>('.code-content');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const mode = tab.dataset.mode;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => { p.hidden = p.dataset.content !== mode; });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.copy-line').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const ok = await copyText(btn.dataset.copy ?? '');
        if (!ok) return;
        const label = btn.querySelector<HTMLElement>('.copy-label');
        btn.classList.add('copied');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'Copy';
        }, 1400);
      });
    });
  }
</script>

<style>
  /* Note on the left, console on the right */
  .qs-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.62fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .qs-console { grid-area: 1 / 2; }
  .qs-note { grid-area: 1 / 1; }

  /* HUD frame ticks, drawn outside the console border */
  .qs-console { position: relative; }
  .qs-console::before,
  .qs-console::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid color-mix(in srgb, var(--color-holo) 55%, transparent);
  }
  .qs-console::before {
    top: -7px;
    left: -7px;
    border-right: 0;
    border-bottom: 0;
  }
  .qs-console::after {
    right: -7px;
    bottom: -7px;
    border-left: 0;
    border-top: 0;
  }

  /* HUD console — always dark, thin powered border + holographic readout */
  .code-block {
    width: 100%;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--color-holo) 42%, var(--color-border));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 60% at 0% 0%, rgba(102, 217, 237, 0.07), transparent 50%),
      #060924;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.38),
                0 0 0 1px color-mix(in srgb, var(--color-holo) 10%, transparent),
                0 0 34px color-mix(in srgb, var(--color-holo) 10%, transparent);
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-holo) 18%, #11163c);
    background: rgba(33, 80, 166, 0.08);
  }
  .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
  .dot-red { background: #2150a6; opacity: 0.5; }
  .dot-yellow { background: #4a83c9; opacity: 0.7; }
  .dot-green { background: #66d9ed; box-shadow: 0 0 8px rgba(102, 217, 237, 0.55); }

  .mode-switch {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .mode-btn {
    padding: 0.3em 0.8em;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: #7d8b9c;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .mode-btn:hover { color: #b9c6d6; }
  .mode-btn.active {
    color: #66d9ed;
    background: rgba(102, 217, 237, 0.1);
    border-color: rgba(102, 217, 237, 0.38);
  }

  .code-body {
    max-width: 100%;
    padding: 1.1rem 1.25rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.85;
    overflow-x: auto;
  }
  .code-content { min-width: max-content; }
  .code-line {
    width: max-content;
    min-width: 100%;
    white-space: pre;
    display: flex;
    align-items: center;
    gap: 0.55ch;
  }
  .code-line.comment { color: #7180aa; }
  .code-line.out {
    color: #66d9ed;
    letter-spacing: 0.015em;
    text-shadow: 0 0 12px rgba(102, 217, 237, 0.28);
  }
  .code-line.out::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: #66d9ed;
    box-shadow: 0 0 9px rgba(102, 217, 237, 0.7);
    flex: 0 0 auto;
  }
  .prompt { color: #66d9ed; }
  .ctext { color: #f5f8ff; }
  .arg { color: #91aee8; }

  .copy-line {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 40px;
    padding: 0 1.1rem;
    border: 1px solid #1f2c3d;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    color: #8b99aa;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .copy-line svg { width: 18px; height: 18px; }
  /* The `hidden` attribute doesn't apply to inline SVG — drive icon swap via class */
  .copy-line .ic-check { display: none; }
  .copy-line.copied .ic-copy { display: none; }
  .copy-line.copied .ic-check { display: block; }
  .copy-line:hover {
    color: #66d9ed;
    border-color: rgba(102, 217, 237, 0.42);
    background: rgba(102, 217, 237, 0.08);
  }
  .copy-line.copied { color: #66d9ed; border-color: rgba(102, 217, 237, 0.42); }

  .caret {
    display: inline-block;
    width: 9px;
    height: 1.1em;
    background: #66d9ed;
    box-shadow: 0 0 9px rgba(102, 217, 237, 0.65);
    vertical-align: text-bottom;
    animation: caret-blink 1.1s steps(1, end) infinite;
  }
  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  .qs-note {
    margin: 0;
    padding-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .qs-note a { font-weight: 600; display: inline-block; margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .qs-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    /* console first, note underneath */
    .qs-console { grid-area: auto; }
    .qs-note { grid-area: auto; padding-top: 0; }
  }

  @media (max-width: 520px) {
    .code-header { gap: 0.55rem; padding: 0.65rem 0.75rem; }
    .dot { width: 8px; height: 8px; }
    .mode-btn { padding: 0.28em 0.65em; font-size: 0.75rem; }
    .code-body { padding: 1rem; font-size: 0.82rem; }
    .copy-label { display: none; }
    .copy-line { padding: 0 0.75rem; }
    .qs-console::before,
    .qs-console::after { display: none; }
  }
</style>
