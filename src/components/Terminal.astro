---
import { site } from '../config/site';
---

<div class="terminal">
  <!-- Traffic-light dots -->
  <div class="terminal-dots" aria-hidden="true">
    <span class="dot dot-red"></span>
    <span class="dot dot-yellow"></span>
    <span class="dot dot-green"></span>
  </div>

  <!-- Command lines -->
  <pre class="terminal-body"><code><span class="prompt">$</span> <span class="cmd">curl -fsSL open-jarvis.github.io/install.sh | bash</span>
<span class="prompt">$</span> <span class="cmd">jarvis init</span>                    <span class="comment"># one-time setup &amp; model pull</span>
<span class="prompt">$</span> <span class="cmd">jarvis ask <span class="arg">&quot;what&apos;s on my calendar today?&quot;</span></span>
  <span class="output">→ answered locally on your GPU · 0 cloud calls · 1.2s</span>
<span class="prompt">$</span> <span class="cmd">jarvis serve</span>                   <span class="comment"># OpenAI-compatible API</span>
  <span class="output">→ live at http://localhost:8000</span></code></pre>

  <!-- Copy install button -->
  <button
    id="copy-install-btn"
    class="copy-btn"
    data-install={site.install}
    aria-label="Copy install command"
  >
    Copy install
  </button>
</div>

<script>
  import { copyText } from '../lib/clipboard';

  const btn = document.getElementById('copy-install-btn') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.install ?? '';
      const ok = await copyText(text);
      if (ok) {
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      }
    });
  }
</script>

<style>
  .terminal {
    background: #0b0f14;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.08),
                0 8px 32px rgba(8, 145, 178, 0.18),
                0 2px 8px rgba(0, 0, 0, 0.5);
    max-width: 520px;
    width: 100%;
    padding: 16px 20px 20px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /* Traffic-light dots */
  .terminal-dots {
    display: flex;
    gap: 6px;
    margin-bottom: 14px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red    { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green  { background: #27c93f; }

  /* Terminal body */
  .terminal-body {
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    overflow-x: auto;
    white-space: pre;
    font-size: inherit;
    line-height: inherit;
    font-family: inherit;
  }

  .terminal-body code {
    font-family: inherit;
    font-size: inherit;
    background: transparent;
    border: none;
    padding: 0;
  }

  /* Syntax colours */
  .prompt  { color: #3fb6c9; }
  .cmd     { color: #e6eef4; }
  .arg     { color: #e7c87a; }
  .comment { color: #7d8b96; }
  .output  { color: #7d8b96; }

  /* Copy button */
  .copy-btn {
    margin-top: 14px;
    padding: 0.35em 0.9em;
    background: transparent;
    color: #3fb6c9;
    border: 1px solid #3fb6c9;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .copy-btn:hover {
    background: #3fb6c9;
    color: #0b0f14;
  }

  .copy-btn:focus-visible {
    outline: 2px solid #3fb6c9;
    outline-offset: 3px;
  }
</style>
